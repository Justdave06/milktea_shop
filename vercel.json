{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd /var/task && composer install --no-dev --optimize-autoloader --no-interaction && npm run build",
  "devCommand": "php artisan serve",
  "installCommand": "composer install --no-dev --optimize-autoloader --no-interaction && npm install",
  "functions": {
    "public/index.php": {
      "runtime": "php@8.4",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.php"
    }
  ],
  "outputDirectory": "public"
}